# Copy this file to .env next to NovelWriter.exe, then restart the application.
# Configure only the service you use. Do not share your real API keys.

# Third-party API (internal ID: hosted-llm): full OpenAI-compatible base URL.
HOSTED_LLM_BASE_URL=http://127.0.0.1:8000/v1
HOSTED_LLM_MODEL=your-served-model-name
# Leave empty for local servers without authentication.
HOSTED_LLM_API_KEY=
# Legacy HOSTED_LLM_URL + HOSTED_LLM_PORT are also supported.

# DeepSeek official API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Qwen official API (Alibaba Cloud Model Studio, Beijing by default).
# If using another region or a workspace-specific URL, change this base URL
# and use an API key created in that same region.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
